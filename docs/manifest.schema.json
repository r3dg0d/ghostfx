{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r3dg0d/ghostfx/docs/manifest.schema.json",
  "title": "GhostFX manifest",
  "type": "object",
  "required": [
    "schema_version",
    "shader_count",
    "shaders",
    "common_parameters",
    "categories"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "shader_count": {
      "type": "integer",
      "minimum": 1
    },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "count"
        ]
      }
    },
    "common_parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/param"
      }
    },
    "shaders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shader"
      }
    }
  },
  "$defs": {
    "param": {
      "type": "object",
      "required": [
        "name",
        "type",
        "default",
        "min",
        "max",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "type": {
          "enum": [
            "float",
            "int",
            "bool"
          ]
        },
        "default": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "shader": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "description",
        "author",
        "license",
        "version",
        "source",
        "dist",
        "mode",
        "animated",
        "presets",
        "tags",
        "parameters",
        "required_capabilities",
        "known_limitations",
        "platforms",
        "verification",
        "benchmark",
        "previews"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 20
        },
        "author": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "dist": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "background",
            "overlay",
            "glow",
            "post",
            "distort"
          ]
        },
        "animated": {
          "type": "boolean"
        },
        "flashing": {
          "type": "boolean"
        },
        "distorts_text": {
          "type": "boolean"
        },
        "reduced_motion": {
          "type": "boolean"
        },
        "presets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "preset_values": {
          "type": "object"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "colors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/param"
          }
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "min_ghostty": {
          "type": "string"
        },
        "known_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attribution": {
          "type": [
            "string",
            "null"
          ]
        },
        "platforms": {
          "type": "object",
          "properties": {
            "linux": {
              "type": "string"
            },
            "macos": {
              "type": "string"
            }
          }
        },
        "verification": {
          "type": "object"
        },
        "benchmark": {
          "type": "object"
        },
        "previews": {
          "type": "object"
        }
      }
    }
  }
}
